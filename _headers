# Cloudflare Pages headers — applied to every matching path.
# Mirror of the cache policy that used to live in `firebase.json`.
#
# The HTML entry points, the 404 page and the service worker must NOT
# be long-cached, otherwise the PWA's cache-first strategy pins users
# to an old shell and a 404 page edit wouldn't reach visitors until
# they cleared the cache. JS/CSS/image assets are fingerprinted only
# when changed, so a 1-year cache is safe.

/
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

/site/*
  Cache-Control: public, max-age=0, must-revalidate

/tools/*
  Cache-Control: public, max-age=0, must-revalidate

/team/*
  Cache-Control: public, max-age=0, must-revalidate
/config/*
  Cache-Control: public, max-age=0, must-revalidate
/about/*
  Cache-Control: public, max-age=0, must-revalidate
/legal/*
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.gif
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable
